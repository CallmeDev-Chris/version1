# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173

# Where contact-form messages are delivered
CONTACT_TO_EMAIL=kuzojean80@gmail.com

# SMTP credentials used to actually send the email.
# With Gmail: use an App Password (not your normal password) —
# https://myaccount.google.com/apppasswords — 2FA must be on.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-address@gmail.com
SMTP_PASS=your-16-char-app-password
